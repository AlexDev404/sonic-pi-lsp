{
  "name": "sonic-pi-lsp",
  "version": "0.1.0",
  "description": "A Language Server Protocol server for Sonic Pi: hover docs, completion, signature help and diagnostics in any LSP editor",
  "license": "MIT",
  "bin": {
    "sonic-pi-lsp": "dist/sonic-pi-lsp.cjs"
  },
  "files": [
    "dist/sonic-pi-lsp.cjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/bundle.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test \"build/test/**/*.test.js\"",
    "extract-docs": "ruby tools/extract-docs.rb"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "main": "dist/sonic-pi-lsp.cjs"
}
