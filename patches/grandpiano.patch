diff --git a/app/server/ruby/lib/sonicpi/synths/synthinfo.rb b/app/server/ruby/lib/sonicpi/synths/synthinfo.rb
index 9a629bed..800eb4e6 100644
--- a/app/server/ruby/lib/sonicpi/synths/synthinfo.rb
+++ b/app/server/ruby/lib/sonicpi/synths/synthinfo.rb
@@ -2413,6 +2413,102 @@ Also, note that audio in isn't yet supported on Raspberry Pi."
       end
     end
 
+    class SynthGrandPiano < SonicPiSynth
+      def name
+        "Grand Piano"
+      end
+
+      def introduced
+        Version.new(5,0,0)
+      end
+
+      def synth_name
+        "grandpiano"
+      end
+
+      def doc
+        "An additive grand piano, built from measurements of a sampled Yamaha C5 (the Salamander Grand Piano, CC BY 3.0). Each note has up to 96 slightly inharmonic partials with their measured levels and decays (the lowest 16 with a slightly detuned second string), building up over a few milliseconds as a real string does, plus the hammer's thump and click. Unlike `:piano`, the note rings for as long as `sustain:` holds the key and then fades over `release:`, like lifting the key. Apart from `amp:` and `pan:`, its opts are fixed when the note starts and can't be changed with `control`."
+      end
+
+      def arg_defaults
+        {
+          :note => 60,
+          :amp => 1,
+          :pan => 0,
+          :vel => 0.5,
+          :hard => 0.5,
+          :sustain => 6,
+          :release => 1,
+          :decay_scale => 1,
+          :thump => 1,
+          :stereo_width => 0.4,
+        }
+      end
+
+      def specific_arg_info
+        {
+          :note =>
+          {
+            :doc => "Note to play. Either a MIDI number or a symbol representing a note. For example: `30`, `52`, 56.5, `:C`, `:C2`, `:Eb4`, or `:Ds3`. The piano's range is A0 (21) to C8 (108); notes outside it take the timbre of the nearest end.",
+            :validations => [v_positive(:note), v_less_than(:note, 131)],
+            :modulatable => false,
+            :midi => true
+          },
+
+          :vel =>
+          {
+            :doc => "Velocity of the keypress, 0 to 1. Higher is louder and brighter.",
+            :validations => [v_between_inclusive(:vel, 0, 1)],
+            :modulatable => false
+          },
+
+          :hard =>
+          {
+            :doc => "Hardness of the hammer, 0 to 1. Tilts the tone: higher is brighter, lower is softer.",
+            :validations => [v_between_inclusive(:hard, 0, 1)],
+            :modulatable => false
+          },
+
+          :sustain =>
+          {
+            :doc => "Amount of time (in beats) the key is held. The note rings with its natural decay for this long.",
+            :validations => [v_positive(:sustain)],
+            :modulatable => false,
+            :bpm_scale => true
+          },
+
+          :release =>
+          {
+            :doc => "Amount of time (in beats) for the damper to silence the note after `sustain:`.",
+            :validations => [v_positive(:release)],
+            :modulatable => false,
+            :bpm_scale => true
+          },
+
+          :decay_scale =>
+          {
+            :doc => "Stretches (above 1) or shortens (below 1) the strings' natural decay. It is a factor, not a time, so it doesn't change with the BPM.",
+            :validations => [v_positive_not_zero(:decay_scale)],
+            :modulatable => false
+          },
+
+          :thump =>
+          {
+            :doc => "Level of the hammer noise (the low thump and the short click) on top of the strings. 0 removes it, 1 is as measured.",
+            :validations => [v_positive(:thump)],
+            :modulatable => false
+          },
+
+          :stereo_width =>
+          {
+            :doc => "Width of the stereo effect (which makes low notes sound towards the left, high notes towards the right). 0 to 1.",
+            :validations => [v_between_inclusive(:stereo_width, 0, 1)],
+            :modulatable => false
+          }
+        }
+      end
+    end
+
     class Growl < SonicPiSynth
       def name
         "Growl"
@@ -9797,6 +9893,7 @@ Note: sliding the `phase:` opt with `phase_slide:` will also cause each echo dur
         :stereo_player => StereoPlayer.new,
         :blade => SynthViolin.new,
         :piano => SynthPiano.new,
+        :grandpiano => SynthGrandPiano.new,
         :rodeo => SynthRodeo.new,
         :kalimba => SynthKalimba.new,
         :pluck => SynthPluck.new,
