 # cargo tracks incremental freshness itself, so run it every build.
 if(CLOCKWORK_RUST)
diff --git a/src/shm_segment.hpp b/src/shm_segment.hpp
index 5fe2fe3..851e242 100644
--- a/src/shm_segment.hpp
+++ b/src/shm_segment.hpp
@@ -50,6 +50,12 @@
 #  include <sys/mman.h>
 #  include <sys/stat.h>
 #  include <unistd.h>
+#  if defined(__ANDROID__)
+// Android's libc has no POSIX shared memory. Its paths share the arena with a
+// client in another process; an app's engine and client share one, so refuse.
+static inline int shm_open(const char*, int, mode_t) { errno = ENOSYS; return -1; }
+static inline int shm_unlink(const char*) { errno = ENOSYS; return -1; }
+#  endif
 #endif
 #include <cstdio>
 #include <random>
