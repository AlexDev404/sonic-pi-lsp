 endif()
 
 if(MSVC)
@@ -992,8 +996,11 @@ else()
     set(CLOCKWORK_RUST_TARGET_DIR ${CLOCKWORK_RUST_WORKSPACE}/target/${CLOCKWORK_RUST_PROFILE})
     set(CLOCKWORK_RUST_CARGO_ENV)
 endif()
