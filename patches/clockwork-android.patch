diff --git a/CMakeLists.txt b/CMakeLists.txt
index aabf32d..20203ec 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -839,7 +839,11 @@ elseif(APPLE)
         "-framework CoreFoundation" "-framework AVFoundation")
 elseif(UNIX)
     find_package(Threads REQUIRED)
-    target_link_libraries(clockwork PUBLIC Threads::Threads rt ${CMAKE_DL_LIBS})
+    if(ANDROID)   # librt is part of Android's libc
+        target_link_libraries(clockwork PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
+    else()
+        target_link_libraries(clockwork PUBLIC Threads::Threads rt ${CMAKE_DL_LIBS})
